OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_TEXT_MODEL=gemma4:e4b-extended
OPENAI_VISION_MODEL=glm-ocr
OPENAI_NUM_PARALLEL=8
NATS_URL=nats://127.0.0.1:4222
SERVER_PORT=50051
APP_QUEUE_SIZE=100
WORKER_POOL_SIZE=8
OPENAI_BASE_PROMPT="You are a strict business employee that follows all directions and does not deviate."
OPENAI_NUM_CTX=2048
NATS_MAX_ACK_PENDING=80
NATS_PULL_MAX_MESSAGES=8
DEFAULT_BASE_PROMPT="You are a strict AI assistant executing tasks for a business application. Your only goal is to handle the provided tasks exactly as described with 0 creativity. Do not hallucinate, explain, or add any unrequested information."
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT_MINUTES=5
NATS_NACK_ERROR_TIMEOUT=15
NATS_RATE_LIMIT_DELAY=15
NATS_REPLY_DELAY=15
# Logger Settings
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true
